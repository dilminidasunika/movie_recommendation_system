POSTGRES_PASSWORD=
POSTGRES_USER=
POSTGRES_DB=
GEMINI_API_KEY=

# Reverse proxy site address / domain (e.g. example.com or localhost)
SITE_ADDRESS=
# Allowed origins for CORS (JSON array, e.g. ["http://localhost:5173"])
CORS_ORIGINS=
# Application environment: dev or prod (prod disables docs and enables TrustedHostMiddleware)
APP_ENV=
# Allowed Host header hostnames in prod (JSON array, e.g. ["localhost","127.0.0.1"])
ALLOWED_HOSTS=
# Trusted proxy IP/CIDR for forwarded headers in uvicorn (set to proxy IP in prod; never "*")
FORWARDED_ALLOW_IPS=
